@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 16
skinparam ArrowColor #087C61
skinparam ClassBorderColor #087C61
skinparam ClassBackgroundColor #EAF7ED
skinparam ActorBorderColor #192D3D
skinparam UsecaseBackgroundColor #EAF7ED
skinparam UsecaseBorderColor #087C61
skinparam ActivityBackgroundColor #EAF7ED
skinparam ActivityBorderColor #087C61
skinparam ParticipantBackgroundColor #EAF7ED
skinparam ParticipantBorderColor #087C61
skinparam NoteBackgroundColor #FFF6DF
skinparam NoteBorderColor #C5AB62
skinparam roundcorner 8
skinparam dpi 160
top to bottom direction
component "Browser\nDjango templates + CSS" as Browser
package "Django application" {
 component "accounts\nauthentication and roles" as Accounts
 component "Web views and forms\nhouseholds / predictions / dashboard" as Views
 component "ml_engine.api_views\nDRF session API" as API
 component "predictions.services\nsave / explain original inputs" as Service
 component "Domain models\nhouseholds / predictions / accounts" as Models
 component "ml_engine.predictor\nRiskPredictor / lazy SHAP" as Predictor
 component "AuditMiddleware\nand model signals\ncreates AuditLog" as Audit
 component "accounts.signals\nlogin, failed login, logout\ncreates AccountEvent" as AuthEvents
 component "ForcePasswordChangeMiddleware\nflagged users reach only\nthe password pages" as PwGate
 component "households.identity\nkeyed hashes, duplicate and\nfamily-overlap checks" as Identity
}
database "SQLite locally\nPostgreSQL configured" as DB
artifact "Versioned registry\njoblib + manifest + approval" as Model
component "Model training / drift commands" as Training
Browser --> PwGate : every request
PwGate ..> Accounts
Browser --> Accounts
Browser --> Views
Browser --> API
Views ..> Accounts
Accounts --> AuthEvents : auth signals
AuthEvents --> Models : AccountEvent
API ..> Accounts
Views --> Models
Models --> Identity : identity / contact / address keys
Views ..> Identity : similar-household warning
API --> Models
Views --> Service
Service --> Predictor
API --> Service
Models --> Audit : household signals
Models --> DB : ORM
Predictor --> Model : verify / load
Views ..> Model : read manifest metrics (model card)
Training --> Model : new candidate / drift reference
note bottom of Training
 Offline ml_engine management commands
end note
@enduml
